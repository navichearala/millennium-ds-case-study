# Copy to .env and fill in one provider. The pipeline resolves the provider from
# whichever key is present, so you only need one.

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Force a provider instead of auto-detecting: openai | anthropic
# LLM_PROVIDER=auto

# Reference date for all years-of-experience maths, so results do not drift
# with the calendar.
# AS_OF_DATE=2026-08-29
